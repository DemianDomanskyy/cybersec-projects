# Copy this file to .env in the same folder and fill in your own values.
# .env is gitignored — it never gets committed or pushed to GitHub.
# There is no built-in default login; the app refuses to start without these.

APP_USERNAME=admin
APP_PASSWORD=change-me-to-something-real

# Alternative to APP_PASSWORD: set a sha256 hash instead, so the plaintext
# password never sits in this file at all. Generate it with:
#   python -c "import hashlib; print(hashlib.sha256('yourpassword'.encode()).hexdigest())"
# APP_PASSWORD_HASH=
